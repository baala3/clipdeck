{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipdeck",
  "version": "0.1.0",
  "identifier": "dev.clipdeck.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "history",
        "url": "index.html",
        "title": "Clipdeck History",
        "width": 420,
        "height": 480,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "pinned",
        "url": "index.html?mode=pinned",
        "title": "Clipdeck Pinned",
        "width": 420,
        "height": 480,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
