{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipdeck",
  "version": "0.1.0",
  "identifier": "dev.clipdeck.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "menu-host",
        "url": "menu-host.html",
        "title": "Clipdeck",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Clipdeck Settings",
        "width": 560,
        "height": 640,
        "minWidth": 440,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ]
  }
}
